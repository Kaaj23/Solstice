# SOLSTICE environment variables. Copy to `.env.local` for local work.
# NEVER commit real values. On Vercel, add them under Project Settings → Environment Variables.
#
# The site builds and runs without any of these. Without them the waitlist is
# honestly "not open yet": the form is replaced by a notice and the API answers 503.
# Nothing is ever saved or pretend-confirmed. See docs/waitlist.md.

# ── Required to open the waitlist (production) ──────────────────────────────

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Server-only. Do not prefix with NEXT_PUBLIC_.
DATABASE_URL=

# Signs confirm / unsubscribe links. 32+ random characters, e.g. `openssl rand -base64 48`.
# Changing it invalidates every link already emailed.
WAITLIST_TOKEN_SECRET=

# Resend → API Keys. Server-only.
RESEND_API_KEY=

# Sender shown on emails. The domain must be verified in Resend, e.g.
#   SOLSTICE <hello@mail.your-domain.com>
WAITLIST_EMAIL_FROM=

# ── Optional ────────────────────────────────────────────────────────────────

# Origin used in emailed links. Defaults to config/site.ts `url`. Set it to your
# custom domain once you have one, or for a staging deployment.
WAITLIST_BASE_URL=

# Shown on /privacy as the address for data questions. Leave empty to omit.
WAITLIST_PRIVACY_CONTACT=

# ── Local development only (ignored on Vercel; refused when VERCEL is set) ──

# Runs the waitlist in memory and writes emails to files instead of sending them,
# so you can click through sign-up → confirm → unsubscribe with no accounts.
# Data is lost when the server restarts.
# WAITLIST_DRIVER=memory
# WAITLIST_DEV_OUTBOX_DIR=.waitlist-outbox
